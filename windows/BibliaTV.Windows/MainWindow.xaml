<Window x:Class="BibliaTV.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BibliaTV"
        Width="1100" Height="700"
        MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F2F7FF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1769D2">
            <DockPanel Margin="20,0">
                <TextBlock Text="BibliaTV"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Width="300" Height="34"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Padding="8,3"
                             ToolTip="Buscar en la Biblia"
                             KeyDown="SearchBox_KeyDown"/>
                    <Button Content="Buscar"
                            Width="85" Height="34"
                            Margin="8,0,0,0"
                            Background="White"
                            Foreground="#1769D2"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="SearchButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D7E6FA"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="14">
                    <TextBlock DockPanel.Dock="Top"
                               Text="LIBROS DE LA BIBLIA"
                               Foreground="#1769D2"
                               FontWeight="Bold"
                               FontSize="13"
                               Margin="4,5,4,12"/>

                    <ListBox x:Name="BooksList"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             Foreground="#172B4D"
                             SelectionChanged="BooksList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="9,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D7E6FA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="LECTURA BÍBLICA"
                                       Foreground="#1769D2"
                                       FontSize="12"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="CurrentLocation"
                                       Text="Selecciona un libro"
                                       Foreground="#172B4D"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Capítulo:"
                                       VerticalAlignment="Center"
                                       Foreground="#172B4D"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="ChapterSelector"
                                      Width="90" Height="32"
                                      FontSize="14"
                                      SelectionChanged="ChapterSelector_SelectionChanged"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#D7E6FA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ContentPanel"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
